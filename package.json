{
  "name": "react-openapi-generator-hook",
  "version": "0.3.4-experimental",
  "main": "dist/react-openapi-hook.umd.js",
  "module": "dist/react-openapi-hook.es.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "vite build",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "generate:apis": "openapi-generator-cli generate -i openapi-specs.yaml -g typescript-axios --additional-properties=useSingleRequestParameter=true --skip-validate-spec -o ./generated",
    "coverage": "vitest run --coverage --silent",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "OpenApi Generator",
    "React",
    "Hook",
    "useApi"
  ],
  "author": "Stefano Marzo",
  "license": "MIT",
  "description": "React hook to perform HTTP calls with OpenApi Generator models and handle responses efficiently",
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.34.0",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@openapitools/openapi-generator-cli": "^2.23.4",
    "@storybook/addon-docs": "^9.1.3",
    "@storybook/addon-onboarding": "^9.1.3",
    "@storybook/react-vite": "^9.1.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitejs/plugin-react": "^5.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "axios": "1.12.0",
    "eslint": "^9.34.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^9.1.3",
    "happy-dom": "^18.0.1",
    "msw": "^2.10.5",
    "msw-storybook-addon": "^2.0.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-json-pretty": "^2.2.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "shiki": "^3.13.0",
    "storybook": "^9.1.3",
    "typescript": "^5.9.2",
    "vite": "7.1.5",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@openapitools/openapi-generator-cli": ">=2.18.0",
    "axios": "1.12.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "msw": {
    "workerDirectory": [
      "mocks"
    ]
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@heroui/button": "^2.2.26",
    "@heroui/card": "^2.2.24",
    "@heroui/chip": "^2.2.21",
    "@heroui/code": "^2.2.20",
    "@heroui/number-input": "^2.0.17",
    "@heroui/react": "^2.8.4",
    "@heroui/skeleton": "^2.2.16",
    "@heroui/slider": "^2.4.23",
    "@heroui/snippet": "^2.2.27",
    "@heroui/spacer": "^2.2.20",
    "@heroui/system": "^2.4.22",
    "@heroui/tabs": "^2.2.23",
    "@heroui/theme": "^2.4.22",
    "@heroui/tooltip": "^2.2.23",
    "@shikijs/transformers": "^3.13.0",
    "@tailwindcss/vite": "^4.1.13",
    "framer-motion": "^12.23.22",
    "react-shiki": "^0.8.0",
    "shikiji": "^0.10.2",
    "tailwindcss": "^4.1.13"
  }
}
